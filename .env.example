# Copy to .env (`cp -n .env.example .env`) and change the password.
# .env is gitignored. Never commit real secrets.

# --- Postgres container (read by docker compose) ---
POSTGRES_USER=cageops
# Placeholder only: set your own value in .env
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cageops

# --- Application settings (read by cageops_common.config.Settings) ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://cageops:change-me-locally@localhost:5432/cageops
REDIS_URL=redis://localhost:6379/0
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Scraper (cageops_scraper.config.ScraperSettings) ---
# REQUIRED. Identifies us to the site operator; put a real contact email in it. The scraper
# refuses to start while it still says you@example.com. Never put anything secret in it.
# Keep the double quotes: the value has spaces and parentheses, which a shell can't read bare.
SCRAPER_USER_AGENT="CageOps/0.1 (+https://github.com/ar1shah/cageops; you@example.com)"
# Minimum gap between requests to one source, shared by every worker. The real site's floor is
# 1000 (about 1 request/second); a longer robots.txt Crawl-delay overrides it automatically.
SCRAPER_MIN_INTERVAL_MS=1000
SCRAPER_TIMEOUT_S=20
# ufcstats | ufcstats_replay (the local replay server used for benchmarks; separate cache,
# rate limit and circuit breaker from the real site)
SCRAPER_SOURCE=ufcstats
UFCSTATS_BASE_URL=http://ufcstats.com
UFCSTATS_REPLAY_BASE_URL=http://127.0.0.1:8099

# --- Ingestion worker (cageops_worker.ingest.config.IngestSettings) ---
# Runs on Linux or macOS only (WSL2 or Docker on Windows): RQ's job timeouts use SIGALRM.
INGEST_QUEUE=ingest
# Retries after the first attempt; the delay before retry n is random in [d/2, d],
# d = min(cap, base * 2**n) seconds. Set the base to 0 to retry instantly (tests do).
INGEST_MAX_RETRIES=5
INGEST_RETRY_BASE_S=30
INGEST_RETRY_CAP_S=900
INGEST_JOB_TIMEOUT_S=300
# How long an enqueued job id stays "claimed" so it isn't queued twice. Raise it above the expected
# run length for a full-history backfill (about 3.3 hours at 1 request/second).
INGEST_CLAIM_TTL_S=7200
# How long a run's inserted/updated/unchanged counts (read by `status --run`) are kept in Redis.
INGEST_RUN_STATS_TTL_S=604800

# --- Worker process: /healthz and /metrics (D-024) ---
# Containers set the host to 0.0.0.0. Port 0 turns the HTTP server off.
WORKER_HTTP_HOST=127.0.0.1
WORKER_METRICS_PORT=9100
# /healthz returns 503 when the worker's loop hasn't ticked for INGEST_JOB_TIMEOUT_S + this.
WORKER_HEALTH_MARGIN_S=60
# While the site is blocking us (circuit breaker open) a worker holds and re-checks this often.
WORKER_HOLD_POLL_S=30
# How often the background thread re-reads Redis/Postgres for the /healthz body and the gauges.
WORKER_SNAPSHOT_INTERVAL_S=10
WORKER_PROBE_TIMEOUT_S=2

# --- Benchmark (scripts/bench_ingest.py) ---
# Optional. By default it uses your DATABASE_URL / REDIS_URL with the database swapped for
# `cageops_bench` and Redis database 2; it refuses to reset anything else.
# BENCH_DATABASE_URL=postgresql://cageops:change-me-locally@localhost:5432/cageops_bench
# BENCH_REDIS_URL=redis://localhost:6379/2

# --- Tests ---
# Tests that need Postgres skip if it's unreachable. Set to 1 to make that a failure
# (CI does this so the database tests can never be silently skipped).
# REQUIRE_DB=1
# Same for the Redis tests (they use Redis database 15 and wipe it between tests).
# REQUIRE_REDIS=1

# --- Seed data download (scripts/download_seed.sh) ---
# Kaggle credentials live in ~/.kaggle/, outside this repo. They are not environment
# variables here and must never be committed.

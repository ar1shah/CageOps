# Copy to .env (`cp -n .env.example .env`) and change the password.
# .env is gitignored. Never commit real secrets.

# --- Postgres container (read by docker compose) ---
POSTGRES_USER=cageops
# Placeholder only: set your own value in .env
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cageops

# --- Application settings (read by cageops_common.config.Settings) ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://cageops:change-me-locally@localhost:5432/cageops
REDIS_URL=redis://localhost:6379/0
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# What "today" means for features and predictions: an IANA zone name. UFC event dates are US-local
# calendar dates, so a US zone keeps a Saturday card "upcoming" until midnight there (D-037).
APP_TIMEZONE=America/New_York

# --- Scraper (cageops_scraper.config.ScraperSettings) ---
# REQUIRED. Identifies us to the site operator; put a real contact email in it. The scraper
# refuses to start while it still says you@example.com. Never put anything secret in it.
# Keep the double quotes: the value has spaces and parentheses, which a shell can't read bare.
SCRAPER_USER_AGENT="CageOps/0.1 (+https://github.com/ar1shah/cageops; you@example.com)"
# Minimum gap between requests to one source, shared by every worker. The real site's floor is
# 1000 (about 1 request/second); a longer robots.txt Crawl-delay overrides it automatically.
SCRAPER_MIN_INTERVAL_MS=1000
SCRAPER_TIMEOUT_S=20
# ufcstats | ufcstats_replay (the local replay server used for benchmarks; separate cache,
# rate limit and circuit breaker from the real site) | wikipedia (event articles under /wiki/ only,
# D-028). Run one source per worker process, each with its own INGEST_QUEUE (e.g. ingest-wikipedia).
SCRAPER_SOURCE=ufcstats
UFCSTATS_BASE_URL=http://ufcstats.com
UFCSTATS_REPLAY_BASE_URL=http://127.0.0.1:8099
WIKIPEDIA_BASE_URL=https://en.wikipedia.org

# --- Ingestion worker (cageops_worker.ingest.config.IngestSettings) ---
# Runs on Linux or macOS only (WSL2 or Docker on Windows): RQ's job timeouts use SIGALRM.
INGEST_QUEUE=ingest
# Retries after the first attempt; the delay before retry n is random in [d/2, d],
# d = min(cap, base * 2**n) seconds. Set the base to 0 to retry instantly (tests do).
INGEST_MAX_RETRIES=5
INGEST_RETRY_BASE_S=30
INGEST_RETRY_CAP_S=900
INGEST_JOB_TIMEOUT_S=300
# How long an enqueued job id stays "claimed" so it isn't queued twice. Raise it above the expected
# run length for a full-history backfill (about 3.3 hours at 1 request/second).
INGEST_CLAIM_TTL_S=7200
# How long a run's inserted/updated/unchanged counts (read by `status --run`) are kept in Redis.
INGEST_RUN_STATS_TTL_S=604800

# --- Worker process: /healthz and /metrics (D-024) ---
# Containers set the host to 0.0.0.0. Port 0 turns the HTTP server off.
WORKER_HTTP_HOST=127.0.0.1
WORKER_METRICS_PORT=9100
# /healthz returns 503 when the worker's loop hasn't ticked for INGEST_JOB_TIMEOUT_S + this.
WORKER_HEALTH_MARGIN_S=60
# While the site is blocking us (circuit breaker open) a worker holds and re-checks this often.
WORKER_HOLD_POLL_S=30
# How often the background thread re-reads Redis/Postgres for the /healthz body and the gauges.
WORKER_SNAPSHOT_INTERVAL_S=10
WORKER_PROBE_TIMEOUT_S=2

# --- Trainer (cageops_trainer.config.TrainerSettings) ---
# Where trained model bundles are written, one directory per version. Gitignored (data/).
MODEL_ARTIFACT_DIR=data/models

# --- API (cageops_api.config.ApiSettings) ---
# MODEL_ARTIFACT_DIR above is read here too: the API loads <dir>/<active version>/.
# How often (seconds) each API process asks the registry which version is active. After
# `cageops_trainer activate`, a running API switches within about this long (D-036).
MODEL_POLL_INTERVAL_S=30
# After a version fails verification, wait this long (seconds) before trying that version again.
MODEL_RELOAD_RETRY_S=300
# Default number of contributing features /predict returns (1 to 10).
PREDICT_TOP_FEATURES=5
# Redis prediction cache (D-042). Set CACHE_ENABLED=false to compute every prediction (for example
# to benchmark without it); when Redis is down the API computes uncached and counts the failure.
CACHE_ENABLED=true
# Seconds an entry lives. A safety net, not the invalidation mechanism (the key is): it bounds what
# the key cannot see (a renamed fighter) and Redis memory. 21600 = 6 hours.
CACHE_TTL_S=21600
# Socket timeout for every Redis call, milliseconds. Short on purpose: a slow cache must cost
# less than recomputing.
REDIS_TIMEOUT_MS=100
# Per-client rate limiting (D-043): a token bucket in Redis, 429 with Retry-After. /healthz, /readyz
# and /metrics are never limited. When Redis is down requests are allowed (and counted).
RATE_LIMIT_ENABLED=true
# Sustained requests per minute, and the burst (bucket size), for one client IP. IPv6 clients are
# one bucket per /64. These are starting values, not measured ones.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
# Comma-separated CIDRs of the reverse proxies in front of the API (Caddy in 2c), for example
# 172.18.0.0/16. X-Forwarded-For is believed only when the immediate peer is in this list, and then
# only up to the first address that is not. Empty (the default) trusts no proxy, which is right
# until there is one: otherwise anyone could pick their own bucket by sending the header.
TRUSTED_PROXY_CIDRS=
# Server-to-server key for the Next.js frontend, whose server components call from a few server IPs.
# At least 32 characters or the frontend class is disabled. Generate one with
# `openssl rand -hex 32`. NEVER commit a real value; set it in the host and in Vercel's server-side
# environment (not NEXT_PUBLIC_*). It is never logged or exposed as a metric label.
FRONTEND_API_KEY=
# The key being rotated out, accepted for the overlap. Leave empty otherwise.
FRONTEND_API_KEY_PREVIOUS=
# A frontend request is limited per end user (the address in X-CageOps-Client-IP, believed only
# with a valid key) and, together, by one ceiling for the whole key.
FRONTEND_USER_RATE_PER_MINUTE=300
FRONTEND_USER_BURST=100
FRONTEND_KEY_RATE_PER_MINUTE=6000
FRONTEND_KEY_BURST=600
# Database connection pool of one API process (D-041). The load test (BENCHMARKS.md) found pool
# size is not what limits throughput, so 5 + 5 stays. Watch api_db_pool_checked_out,
# api_db_pool_checked_out_peak and api_db_pool_checkout_seconds in /metrics.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Seconds a request waits for a free connection before it gets a 503 (database_busy). 5, down from
# 30: the longest wait in a healthy run was about 0.5 s.
DB_POOL_TIMEOUT_S=5

# --- Benchmark (scripts/bench_ingest.py) ---
# Optional. By default it uses your DATABASE_URL / REDIS_URL with the database swapped for
# `cageops_bench` and Redis database 2; it refuses to reset anything else.
# BENCH_DATABASE_URL=postgresql://cageops:change-me-locally@localhost:5432/cageops_bench
# BENCH_REDIS_URL=redis://localhost:6379/2

# --- Tests ---
# Tests that need Postgres skip if it's unreachable. Set to 1 to make that a failure
# (CI does this so the database tests can never be silently skipped).
# REQUIRE_DB=1
# Same for the Redis tests (they use Redis database 15 and wipe it between tests).
# REQUIRE_REDIS=1

# --- Seed data download (scripts/download_seed.sh) ---
# Kaggle credentials live in ~/.kaggle/, outside this repo. They are not environment
# variables here and must never be committed.
